---
import type { FrontmatterPage } from 'astro-boilerplate-components';
import {
  // BlogGallery,
  NewerOlderPagination,
  PaginationHeader,
  Section,
} from 'astro-boilerplate-components';
import { CustomBlogGallery } from '@/partials/CustomBlogGallery';
import { getCollection } from 'astro:content';
import type { CustomIFrontMatter } from '@/partials/BlogPost';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';

type GetStaticPaths = {
  paginate: any;
}; // Overrides GetStaticPathsOptions types from Astro

export async function getStaticPaths({ paginate }: GetStaticPaths) {
  const allPosts = await getCollection('posts');
  // const allPosts = await getCollection<CustomIFrontMatter>('posts');
  
  // Convert content collection entries to match your existing structure
  const postsWithFrontmatter = allPosts.map((post) => ({
    ...post,
    frontmatter: post.data,
    url: `/posts/${post.slug}`,
    // Add any other properties your BlogGallery component expects
  }));
  
  const sortedPosts = sortByDate(postsWithFrontmatter as any);
  // const sortedPosts = sortByDate(allPosts);
  
  // Optional: Filter out future posts
  // const filteredPosts = sortedPosts.filter((post) => {
  //   const postDate = new Date(post.data.pubDate);
  //   const today = new Date();
  //   return postDate <= today;
  // });
  
  // Return a paginated collection of paths for all posts
  return paginate(sortedPosts, { pageSize: 6 });
}

interface Props {
  page: FrontmatterPage;
}

const { page } = Astro.props as Props;
const titleSuffix = ` - ${AppConfig.site_name}`;
const titleBase = `Page ${page.currentPage}`;
const title = titleBase + titleSuffix;
const description = 'Blog post iteration for Astro styled with Tailwind CSS.';
---

<Base head={{ title, description }}>
  <Section>
    <h1 class="text-center text-3xl font-bold text-gray-900 dark:text-gray-100">
      {AppConfig.site_name}
    </h1>
    <p class="mt-2 text-center text-gray-700 dark:text-gray-300">
      Collection of all my blogs.
    </p>
  </Section>

  <Section>
    <CustomBlogGallery postList={page.data} />
  </Section>

  <Section>
    <NewerOlderPagination page={page} />
  </Section>

  <div data-pagefind-body></div>
</Base>
