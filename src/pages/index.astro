---
// import { CTA } from '@/partials/CTA';
import { getCollection } from 'astro:content';
// import type { CustomIFrontMatter } from '@/partials/BlogPost';
import { Hero } from '@/partials/Hero';
// import { ProjectList } from '@/partials/ProjectList';
import { RecentPosts } from '@/partials/RecentPosts';
import Base from '../templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';
// import BottomSection from '../partials/BottomSection.astro';

const allPosts = await getCollection('posts');

// Convert content collection entries to match your existing structure
const postsWithFrontmatter = allPosts.map((post) => ({
  ...post,
  frontmatter: post.data,
  url: `/posts/${post.slug}`,
  // Add any other properties your RecentPosts component expects
}));

const sortedPosts = sortByDate(postsWithFrontmatter);

// Filter out dates that are in the future
const filteredPosts = sortedPosts.filter((post) => {
  const postDate = new Date(post.data.pubDate);
  const today = new Date();
  return postDate <= today;
});

const lastThreePosts = filteredPosts.slice(0, 3);

const { title, description } = AppConfig;
---

<Base head={{ title, description }}>
  <Hero />
  {/*
  <ProjectList />
  */}
  <RecentPosts postList={lastThreePosts} />
  {/*
  <BottomSection />
  */}
  <div data-pagefind-body></div>
</Base>